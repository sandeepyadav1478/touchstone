%% touchstone phase 1 — the adapter, the enforcement point, and the three decisions
%% Every node names a real symbol: touchstone, or tau2-bench — tau2 at commit a2c024725189 (MIT). D-068.
flowchart TB

  subgraph TAU2["τ²-bench · external · MIT · tau2 a2c024725189"]
    direction TB
    RUN["Orchestrator.run<br/>orchestrator.py:260"]
    AGENT["llm_agent.py:128<br/>agent turn"]
    USER["user_simulator.py:235<br/>user turn"]
    REVIEW["hallucination_reviewer.py:196<br/>opt-in, validates the simulator"]
    GEN["llm_utils.generate<br/>llm_utils.py:355"]
    LITE["litellm.completion<br/>llm_utils.py:15"]
    ENVC["Environment.make_tool_call<br/>environment/environment.py:158"]
    MUT["_is_mutating_tool<br/>environment/environment.py:130"]
    EVAL["evaluate_simulation<br/>evaluator.py:88<br/>read back from the shipped JSONs — τ² is not run at scale here"]
    REW["reward_breakdown[DB] — gates<br/>composite reported, never gates"]
  end

  subgraph TS["touchstone"]
    direction TB
    ADP["adapter<br/>replaces litellm at the seam"]
    SDK["ClaudeSDKClient<br/>claude_agent_sdk"]
    CFG["config.py — five pins<br/>MODEL · USER_MODEL · LOOP_MODEL<br/>NL_ASSERTION_MODEL · REVIEW_MODEL"]
    GATE["gate · shadow then enforce<br/>D-064 · D-065"]
    TEL["telemetry.py — provider + exporter<br/>the span is opened by the adapter (D-073)"]
    SUITE["suite<br/>benchmark frozen · regression grows"]
    ADMIT["3 admission gates<br/>reproducible<br/>distinct · justified"]
    DOC["doctor.py<br/>asserts the pins"]
  end

  MLF["mlflow.search_traces<br/>MLFLOW_TRACKING_URI · no service"]
  ANTH["Anthropic<br/>subscription auth · 5h window"]

  subgraph MINE["the INNER loop — D-082 · reads the shipped corpus, not this run"]
    direction LR
    CORPUS[("1,712 shipped simulations<br/>τ² already ran them — D-080")]
    ROUTER{"router agent<br/>rubric — D-082 §A"}
    CURATOR("curator agent<br/>writes the predicate")
    CRITIC("qa / critic agent<br/>argues once per attempt")
    PRED{{"run_predicate()<br/>THE ONLY DECISION POINT<br/>no model — D-081"}}
    CTRL[("control set<br/>878 clean + every SKIP")]
    CORPUS --> ROUTER
    ROUTER -- "enhance" --> CURATOR
    ROUTER -. "skip" .-> CTRL
    CURATOR --> CRITIC --> PRED
    PRED -- "counterexample" --> CURATOR
    CTRL --> PRED
  end

  RUN --> AGENT
  RUN --> USER
  AGENT --> GEN
  USER --> GEN
  REVIEW --> GEN

  GEN -. "replaced" .-> LITE
  GEN ==> ADP
  ADP --> SDK --> ANTH
  CFG --> ADP
  DOC --> CFG

  AGENT --> ENVC
  ENVC --> MUT
  ENVC ==> GATE
  GATE -- "enforce: refuse before the write" --> ENVC

  RUN --> EVAL --> REW

  ADP --> TEL
  ENVC --> TEL
  TEL --> MLF

  REW --> D2
  ADMIT --> D3
  GATE --> D1
  PRED -- "holds" --> ADMIT
  ADMIT --> SUITE
  SUITE --> D2

  D1{{"DECISION 1<br/>refuse a tool call<br/>no model"}}
  D2{{"DECISION 2<br/>reject a candidate version<br/>no model<br/>DEFERRED ENTIRE — D-080, no second operand"}}
  D3{{"DECISION 3<br/>admit a mined case<br/>no model"}}

  classDef nomodel fill:#0b3d2e,stroke:#3ddc97,color:#eaffef,stroke-width:2px
  classDef model fill:#3d2b0b,stroke:#ffb703,color:#fff6e5
  classDef seam fill:#3d0b2b,stroke:#ff5db1,color:#ffe9f5,stroke-width:3px
  classDef dead fill:#2a2a2a,stroke:#666,color:#999
  classDef data fill:#26262e,stroke:#8a8a99,color:#dcdce4
  classDef deferred fill:#1e2a26,stroke:#3ddc97,stroke-dasharray:4 3,color:#8fbfa8

  class D1,D2,D3,REW,ADMIT,MUT nomodel
  class AGENT,USER,REVIEW,SDK,ANTH model
  class GEN,ADP,ENVC seam
  class CORPUS,CTRL data
  class ROUTER,CURATOR,CRITIC model
  class PRED nomodel
  class LITE dead
  class D2 deferred
