%% touchstone — the mining loop's three agents, and where the decision sits. D-082, D-086.
%% The chain: router -> curator <-> critic <-> run_predicate, then critic -> the gauntlet -> suite.
%% Every green node is mechanical. D-086: run_predicate is EVIDENCE the critic reads, not a gate.
%% D-089: the critic holds TWO tools. unmineable is a RESULT it records, never a stage.
flowchart LR

  IN[("1,712 simulations<br/>τ²-bench already shipped")]
  ROUTER{"router agent<br/>rubric — D-082 §A"}

  subgraph LOOP["The Mining Loop — config.MAX_ATTEMPTS on ONE trace"]
    direction LR
    CURATOR("curator agent<br/>decides what is worth encoding,<br/>and writes the predicate")
    CRITIC("qa / critic agent<br/>judges that call, and DECIDES<br/>D-086 §A")
    CURATOR -- "candidate" --> CRITIC
    CRITIC -- "the SPECIFIC bad finding — ONE bounce per attempt" --> CURATOR
  end

  TEST{{"run_predicate()<br/>the critic's tool — EVIDENCE, not a gate<br/>no model — D-086 §A"}}
  BUDGET{{"attempt_budget() — the critic's OTHER tool, D-089<br/>named for the job, not the consequence — D-092<br/>owns config.MAX_ATTEMPTS: says EXIT, records a give-up, may REFUSE<br/>ONE function reads the cap; the graph's edge calls the same one — D-091<br/>a refused give-up costs an attempt and never buys one"}}
  GAUNTLET{{"THE GAUNTLET — three gates, all must hold<br/>reproducible · distinct · justified<br/>no model, ever — D-084<br/>BACKLOG, not deferred: it runs on a FINISHED candidate,<br/>so the loop has to exist before its input does — D-086 §D"}}
  SUITE[("the regression suite")]
  CONTROL[("the control set — 934 clean on the two reproducible signals — D-108<br/>a predicate that fires HERE is a false positive")]
  UNMINED("the trace is done — a RESULT, not an error<br/>attempt_budget already recorded every attempt and its counterexample<br/>exit_reason: budget_exhausted | gave_up | 🔴 force_terminated")
  CAL["criterion_1_agreement<br/>the router's verdict vs τ²'s own signals, over all 1,712<br/>D-082 §B — no result is reportable without it"]

  CLEARED[("the CLEARED suite so far — D-087<br/>exact check BEFORE any agent call: a predicate that already fires<br/>means already_covered, and zero attempts are spent")]

  IN --> ROUTER
  CLEARED -. "the suite index goes in the curator's prompt — still no tool" .-> CURATOR
  ROUTER -- "enhance" --> CURATOR
  ROUTER -. "skip" .-> CONTROL
  CRITIC <-- "its tool, and nobody else's — D-086 §A" --> TEST
  CONTROL -- "the NO half of the evidence" --> TEST
  CRITIC -- "hands over" --> GAUNTLET
  CRITIC <-. "may I keep going? · giving up early" .-> BUDGET
  FLAG("flags any agent raises → the MLflow span, for a human<br/>⛔ the loop does NOT branch on them — D-090 §D")
  CRITIC -. "raises" .-> FLAG
  EDGE{{"🔴 FORCE-TERMINATE — the conditional edge, D-094<br/>fires ONLY when an agent is told to exit and continues anyway<br/>calls attempts_exhausted(), the SAME function the tool calls — D-091<br/>exit_reason: force_terminated · EXPECTED VALUE 0<br/>an alarm, not a category: non-zero is a bug report against a prompt"}}
  BUDGET -- "⛔ its reply IS the exit — nothing hands off, D-094 §A" --> UNMINED
  BUDGET -. "an agent ignores it and keeps going" .-> EDGE
  EDGE --> UNMINED
  GAUNTLET --> SUITE
  ROUTER -.- CAL

  classDef agent fill:#3d2b0b,stroke:#ffb703,stroke-width:2px,color:#fff6e5
  classDef mech  fill:#0b3d2e,stroke:#3ddc97,stroke-width:2px,color:#eaffef
  classDef data  fill:#26262e,stroke:#8a8a99,color:#dcdce4
  classDef note  fill:none,stroke:#8a8a99,stroke-dasharray:3 3,color:#9a9aa8
  classDef box   fill:none,stroke:#666,color:#9a9aa8

  class ROUTER,CURATOR,CRITIC agent
  class TEST,BUDGET,EDGE,GAUNTLET mech
  class IN,SUITE,CONTROL,UNMINED data
  class CAL,FLAG note
  class CLEARED data
  class LOOP box
